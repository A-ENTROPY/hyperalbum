<?xml version="1.0" encoding="utf-8"?>
<!--
  Liquid Glass style launcher icon, V2.
  Mimics iOS 26 / iOS 27 icon design with deeper glass effects:
   * Soft radial backdrop with a brighter top-left light source
   * Outer glass orb (purple-blue gradient) with double highlight crescent
   * Inner glass orb (teal-cyan) — also with crescent
   * Center deep-navy pupil
   * Bottom-right inset shadow for the floating-glass feel
   * Diagonal specular streak across both orbs (sunlight through glass)
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Soft radial backdrop -->
    <path android:pathData="M0,0h108v108H0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38"
                android:centerY="32"
                android:gradientRadius="92"
                android:startColor="#FF3B6FC8"
                android:centerColor="#FF1A2A6B"
                android:endColor="#FF0A0E18" />
        </aapt:attr>
    </path>

    <!-- Outer glass orb (purple-blue) -->
    <path android:pathData="M54,18a36,36 0 1,0 0.001,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="44"
                android:centerY="32"
                android:gradientRadius="48"
                android:startColor="#FFB299FF"
                android:centerColor="#FF6E5BE8"
                android:endColor="#FF3D2BAA" />
        </aapt:attr>
    </path>

    <!-- Outer orb rim shadow (inner edge) -->
    <path
        android:strokeColor="#33000000"
        android:strokeWidth="1.2"
        android:pathData="M54,18a36,36 0 1,0 0.001,0z" />

    <!-- Inner glass orb (teal-cyan) -->
    <path android:pathData="M54,30a24,24 0 1,0 0.001,0z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="48"
                android:centerY="40"
                android:gradientRadius="32"
                android:startColor="#FF6FFFE6"
                android:centerColor="#FF00BFA5"
                android:endColor="#FF007F6E" />
        </aapt:attr>
    </path>

    <!-- Inner orb rim shadow -->
    <path
        android:strokeColor="#33000000"
        android:strokeWidth="0.8"
        android:pathData="M54,30a24,24 0 1,0 0.001,0z" />

    <!-- Center pupil (deep navy) -->
    <path
        android:fillColor="#FF0E1116"
        android:pathData="M54,42a12,12 0 1,0 0.001,0z" />

    <!-- Apple-style highlight crescent — outer orb (upper-left) -->
    <path
        android:fillColor="#80FFFFFF"
        android:pathData="M30,40a26,26 0 0,1 36,-22 22,22 0 0,0 -34,18 22,22 0 0,1 -2,4z" />

    <!-- Inner orb highlight crescent -->
    <path
        android:fillColor="#A0FFFFFF"
        android:pathData="M40,46a18,18 0 0,1 24,-15 14,14 0 0,0 -22,12 14,14 0 0,1 -2,3z" />

    <!-- Bottom-right inset shadow (floating glass) -->
    <path
        android:fillColor="#40000000"
        android:pathData="M68,68a14,14 0 1,1 -14,-14 14,14 0 0,1 14,14z" />

    <!-- Center light reflection -->
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M54,48a4,4 0 1,0 0.001,0z" />

    <!-- Diagonal specular streak (sunlight through glass) -->
    <path
        android:fillColor="#33FFFFFF"
        android:pathData="M20,30 L36,16 L42,22 L26,36 z" />
    <path
        android:fillColor="#22FFFFFF"
        android:pathData="M70,76 L88,58 L94,64 L76,82 z" />

</vector>